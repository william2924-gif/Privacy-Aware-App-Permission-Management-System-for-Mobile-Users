<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Privacy Dashboard"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingBottom="24dp"/>

        <TextView
            android:id="@+id/txtTotalApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Applications"
            android:textSize="20sp"
            android:paddingBottom="16dp"/>

        <TextView
            android:id="@+id/txtHighRisk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="High Risk"
            android:textSize="20sp"
            android:paddingBottom="16dp"/>

        <TextView
            android:id="@+id/txtMediumRisk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medium Risk"
            android:textSize="20sp"
            android:paddingBottom="16dp"/>

        <TextView
            android:id="@+id/txtLowRisk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Low Risk"
            android:textSize="20sp"
            android:paddingBottom="16dp"/>

        <TextView
            android:id="@+id/txtOverallStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Overall Status"
            android:textStyle="bold"
            android:textSize="20sp"
            android:paddingBottom="16dp"/>

        <TextView
            android:id="@+id/txtRecommendation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recommendation"
            android:textSize="18sp"/>

    </LinearLayout>

</ScrollView>